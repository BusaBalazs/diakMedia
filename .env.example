# Firebase web app configuration (Firebase console > Project settings > Your apps).
# These values are not secrets: access is protected by Authentication and the Firestore security rules.
# Leave them empty to run the admin with the temporary development data layer.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
